{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.js",
    "clean": "rm -rf dist",
    "typecheck": "node --stack-size=6000 node_modules/typescript/lib/tsc.js --noEmit",
    "lint": "eslint src tests server.ts vite.config.ts --max-warnings=0",
    "test": "tsx --test tests/*.test.ts",
    "content:validate": "tsx scripts/validateLessons.ts",
    "stroke-data:vendor": "tsx scripts/vendorHanziStrokeData.ts",
    "course-examples:export": "tsx scripts/exportCourseExamples.ts",
    "course-examples:coverage": "tsx scripts/reportCourseExampleCoverage.ts",
    "decomposition:pack": "tsx scripts/buildDecompositionRuntimePacks.ts",
    "decomposition:pack:full": "DECOMPOSITION_RUNTIME_PACK_FULL_COVERAGE=true tsx scripts/buildDecompositionRuntimePacks.ts",
    "decomposition:runtime:measure": "tsx scripts/measureDecompositionRuntime.ts",
    "book-pages:export": "tsx scripts/exportBookPages.ts",
    "dictionary:packs": "tsx scripts/exportDictionaryPacks.ts",
    "memory-hooks:prepare": "tsx scripts/memory-hooks/prepareBookOnePilot.ts",
    "memory-hooks:prepare:batch": "tsx scripts/memory-hooks/prepareBookOneEvaluationBatch.ts",
    "memory-hooks:prepare:labels": "tsx scripts/memory-hooks/buildComponentLabelCandidates.ts",
    "memory-hooks:prepare:label-packet": "tsx scripts/memory-hooks/prepareComponentLabelProposalPacket.ts",
    "memory-hooks:propose:labels": "tsx scripts/memory-hooks/runComponentLabelProposal.ts",
    "memory-hooks:prepare:scene-viability": "tsx scripts/memory-hooks/prepareReviewedLabelsAndSceneViability.ts",
    "memory-hooks:run:scene-viability": "tsx scripts/memory-hooks/runSceneViability.ts",
    "memory-hooks:run:scene-viability:strict": "tsx scripts/memory-hooks/runSceneViabilityStrict.ts",
    "memory-hooks:prepare:frame-recovery": "tsx scripts/memory-hooks/prepareFrameRecoveryPass.ts",
    "memory-hooks:prepare:evidence-recon": "tsx scripts/memory-hooks/prepareRelationshipEvidenceReconnaissance.ts",
    "memory-hooks:prepare:evidence-pilot": "tsx scripts/memory-hooks/prepareTargetRelationshipEvidencePilot.ts",
    "memory-hooks:adjudicate:evidence-pilot": "tsx scripts/memory-hooks/adjudicateTargetRelationshipEvidencePilot.ts",
    "memory-hooks:preview:meanings": "tsx scripts/memory-hooks/previewCanonicalMeaningCleanup.ts",
    "memory-hooks:preview:meaning-profiles": "tsx scripts/memory-hooks/prepareCharacterMeaningProfilePreview.ts",
    "memory-hooks:review:meaning-layer": "tsx scripts/memory-hooks/reviewConstructionMeaningLayer.ts",
    "memory-hooks:generate:pilot": "tsx scripts/memory-hooks/generatePilotHooksV2.ts",
    "memory-hooks:critic:pilot": "tsx scripts/memory-hooks/criticPilotHooksV2.ts",
    "memory-hooks:review:style": "tsx scripts/memory-hooks/reviewPilotStyleLocally.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-virtual": "^3.13.26",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "axios": "^1.18.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "hanzi-writer": "^3.7.3",
    "idb-keyval": "^6.2.5",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "msedge-tts": "^2.0.7",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-icons": "^5.6.0",
    "swiper": "^12.1.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "hanzi-writer-data": "^2.0.1",
    "typescript-eslint": "^8.65.0"
  }
}
