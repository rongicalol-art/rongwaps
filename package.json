{
  "name": "rongwaps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "server": "tsx server/index.ts",
    "build:server": "esbuild server/index.ts --platform=node --bundle --outfile=dist-server/server.js --format=esm --packages=external --external:express --external:@supabase/supabase-js --external:dotenv --define:process.env.NODE_ENV='\"production\"'",
    "build": "vite build && npm run build:server",
    "start": "node dist-server/server.js",
    "clean": "rm -rf dist dist-server",
    "clean:local": "rm -rf output dist dist-server .audit .vite",
    "typecheck": "node --stack-size=6000 node_modules/typescript/lib/tsc.js --noEmit",
    "lint": "eslint src tests server scripts vite.config.ts --max-warnings=0",
    "test": "ACCEPTANCE_STRICT=true tsx --test tests/*.test.ts tests/unit/*.test.ts tests/content/*.test.ts tests/pipeline/*.test.ts",
    "content:export": "tsx scripts/content/exportAuthoredContent.ts",
    "content:validate": "tsx scripts/content/validateLessons.ts",
    "stroke-data:vendor": "tsx scripts/strokes/vendorHanziStrokeData.ts",
    "audio:sync:r2": "tsx scripts/audio/syncAudioToR2.ts",
    "font:huninn:vendor": "tsx scripts/assets/vendorHuninn.ts",
    "font:vendor": "tsx scripts/assets/vendorFonts.ts",
    "course-examples:export": "tsx scripts/content/exportCourseExamples.ts",
    "course-examples:coverage": "tsx scripts/content/reportCourseExampleCoverage.ts",
    "decomposition:pack": "tsx scripts/character-decomposition/buildDecompositionRuntimePacks.ts",
    "decomposition:pack:full": "DECOMPOSITION_RUNTIME_PACK_FULL_COVERAGE=true tsx scripts/character-decomposition/buildDecompositionRuntimePacks.ts",
    "decomposition:runtime:measure": "tsx scripts/character-decomposition/measureDecompositionRuntime.ts",
    "book-pages:export": "tsx scripts/content/exportBookPages.ts",
    "breakdowns:patch": "tsx scripts/content/patchBreakdowns.ts",
    "dictionary:packs": "tsx scripts/dictionary/exportDictionaryPacks.ts",
    "dictionary:restore": "tsx scripts/dictionary/restoreDictionaryFromPacks.ts",
    "dictionary:frequency:build": "output/venv/bin/python scripts/dictionary/buildDictionaryFrequency.py",
    "dictionary:frequency:apply": "tsx scripts/dictionary/addDictionaryFrequency.ts",
    "hooks": "tsx scripts/memory-hooks/cli.ts",
    "hooks:prepare": "tsx scripts/memory-hooks/cli.ts prepare",
    "hooks:run": "tsx scripts/memory-hooks/cli.ts run",
    "hooks:gates": "tsx scripts/memory-hooks/cli.ts gates",
    "hooks:check": "tsx scripts/memory-hooks/cli.ts check",
    "hooks:review": "tsx scripts/memory-hooks/cli.ts review-page",
    "hooks:export": "tsx scripts/memory-hooks/cli.ts export",
    "pronunciation:build": "tsx scripts/pronunciation/buildPronunciation.ts",
    "relations:build": "tsx scripts/relations/buildParts.ts",
    "levels:build": "tsx scripts/levels/buildLevels.ts",
    "jev:check": "tsx scripts/jev/client.ts --check",
    "jev:lint": "tsx scripts/jev/lintRules.ts",
    "jev:lint:staged": "tsx scripts/jev/lintRules.ts --staged",
    "jev:lint:strict": "tsx scripts/jev/lintRules.ts --strict",
    "jev:verify": "tsx scripts/jev/verifyHandoff.ts",
    "jev:context": "tsx scripts/jev/contextRouter.ts",
    "jev:qa:words": "tsx scripts/jev/reviewWordHooksTypesafe.ts",
    "jev:qa:grammar": "tsx scripts/jev/reviewGrammarExamples.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@supabase/supabase-js": "^2.105.3",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "hanzi-writer": "^3.7.3",
    "idb-keyval": "^6.2.5",
    "lottie-react": "^2.4.1",
    "motion": "^12.23.24",
    "msedge-tts": "^2.0.7",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-icons": "^5.6.0",
    "react-router": "^8.3.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.7",
    "@typesafe-ai/sdk": "^0.6.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "hanzi-writer-data": "^2.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
