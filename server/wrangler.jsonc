{
  // The live site. Released by .github/workflows/deploy.yml (docs/RELEASING.md); `npm start` runs it locally.
  // ronsmandarin.com is attached to this Worker in the Cloudflare dashboard (Settings → Domains & Routes),
  // so the release token needs no access to the domain itself.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "rons-mandarin",
  "main": "worker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // A missing page under /books, /grammar or /tocfl (/books/1, a mistyped lesson page) gets that folder's
    // 404.html, the app shell, with status 404 (scripts/build/prerender.ts): the app takes the address like any unknown
    // one instead of a blank page. Other folders have no 404.html, so a missing file there stays an empty 404.
    // Never "single-page-application": that would answer 200 for a missing file.
    "not_found_handling": "404-page",
    // The server runs first for every address EXCEPT the public files listed here, which Cloudflare serves
    // on its own (free and unlimited). Lesson content (/data) is never on this list: an address that matches
    // nothing below reaches the server, which checks the school account. tests/unit/serverAssets.test.ts
    // keeps this list in step with the files the build produces.
    "run_worker_first": [
      "/*",
      "!/", "!/index.html", "!/books", "!/books/*", "!/grammar", "!/grammar/*", "!/tocfl", "!/tocfl/*", "!/about", "!/privacy", "!/terms", "!/sources",
      "!/assets/*", "!/downloads/*", "!/fonts/*", "!/icons/*", "!/videos/*",
      "!/sw.js", "!/workbox-*.js", "!/manifest.json", "!/asset-manifest.json",
      "!/robots.txt", "!/sitemap.xml", "!/llms.txt", "!/favicon.ico", "!/share.png", "!/share-square.png", "!/share/*"
    ]
  },
  // Public values. COMMIT and SUPABASE_ANON_KEY arrive with each deploy (--var); the email and Sentry
  // settings are Worker secrets (docs/RELEASING.md → Remaining one-time setup).
  "vars": {
    "APP_ENV": "production",
    "SUPABASE_URL": "https://ylpzxpqyfaayavkvhikw.supabase.co",
    "GAMES_SERVER_URL": "https://rons-mandarin-games.ronm222007.workers.dev",
    // The cloud voice (server/speech.ts). Its key is the Worker secret AZURE_SPEECH_KEY.
    "AZURE_SPEECH_REGION": "japaneast"
  },
  // Where the cloud voice keeps what Azure made, so each text is made once (server/speech.ts).
  "r2_buckets": [{ "binding": "SPEECH_AUDIO", "bucket_name": "rongwaps-speech" }],
  // Counted per Cloudflare location, a minute at a time (server/auth.ts).
  "ratelimits": [
    { "name": "IP_LIMIT", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "CONTENT_LIMIT", "namespace_id": "1002", "simple": { "limit": 1200, "period": 60 } },
    { "name": "FEEDBACK_LIMIT", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } },
    { "name": "REPORT_LIMIT", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    { "name": "SPEECH_LIMIT", "namespace_id": "1005", "simple": { "limit": 40, "period": 60 } }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
